{
  "name": "la-roue",
  "productName": "Roue des sanctions",
  "version": "1.1.1",
  "description": "Roue des sanctions du serveur Discord Roblox France (discord.gg/robloxfr).",
  "author": {
    "name": "Roblox France"
  },
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/build-win.js",
    "icone": "node scripts/make-icon.js"
  },
  "devDependencies": {
    "electron": "44.7.1",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "fr.cogec.laroue",
    "productName": "Roue des sanctions",
    "copyright": "© 2026 Roblox France",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "compression": "maximum",
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Roue des sanctions",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Roue des sanctions",
      "language": "1036",
      "installerLanguages": [
        "fr_FR"
      ],
      "artifactName": "Roue-des-sanctions-Setup-${version}.${ext}"
    }
  }
}
